<section class="card">
    <h2>Staff Login</h2>
    <% if (typeof error !== 'undefined') { %>
        <p class="error"><%= error %></p>
    <% } %>
    <form method="post" action="/auth/login" class="form-grid">
        <label>Username
            <input name="username" required>
        </label>
        <label>Password
            <input name="password" type="password" required>
        </label>
        <button class="btn" type="submit">Login</button>
    </form>
    <p class="muted">Default accounts: admin/admin123, reception/reception123</p>
</section>


