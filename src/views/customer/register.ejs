<section class="card" style="max-width: 720px; margin: 40px auto;">
    <div class="badge badge-info">New Guest Registration</div>
    <h2 style="margin-bottom: 8px;">Create customer account</h2>
    <p class="muted" style="margin-bottom: 24px;">Your registered mobile number is your login ID — easy to remember, no separate username.</p>

    <% if (error) { %>
        <div class="panel error" style="margin-bottom: 20px; border-color: rgba(225, 29, 72, 0.3);">
            <%= error %>
        </div>
    <% } %>

    <form method="post" action="/customer/register" class="form-grid">
        <label>
            <strong>Mobile number <span style="color: var(--danger);">*</span></strong>
            <input name="phone" type="tel" value="<%= form.phone || '' %>" required placeholder="10-digit mobile number" pattern="[0-9]{10}" maxlength="10" autocomplete="tel">
            <span class="muted" style="font-size:0.82rem;">This will also be your login ID</span>
        </label>

        <label>
            <strong>Email Address <span style="color: var(--danger);">*</span></strong>
            <input name="email" type="email" value="<%= form.email || '' %>" required placeholder="your@email.com" autocomplete="email">
        </label>

        <label>
            <strong>Password <span style="color: var(--danger);">*</span></strong>
            <input name="password" type="password" required placeholder="Min. 6 characters" autocomplete="new-password">
        </label>

        <label>
            <strong>Confirm Password <span style="color: var(--danger);">*</span></strong>
            <input name="confirm_password" type="password" required placeholder="Re-enter password" autocomplete="new-password">
        </label>

        <label style="grid-column: 1 / -1;">
            <strong>Full Name <span style="color: var(--danger);">*</span></strong>
            <input name="name" value="<%= form.name || '' %>" required placeholder="Enter your full name" autocomplete="name">
        </label>

        <label style="grid-column: 1 / -1;">
            <strong>Aadhar Number <span style="color: var(--danger);">*</span></strong>
            <input name="aadhar" type="text" value="<%= form.aadhar || '' %>" required placeholder="12-digit Aadhar number" pattern="[0-9]{12}" maxlength="12">
        </label>

        <label style="grid-column: 1 / -1;">
            <strong>Address</strong>
            <textarea name="address" rows="3" placeholder="Your address (optional)"><%= form.address || '' %></textarea>
        </label>

        <div style="grid-column: 1 / -1; margin-top: 8px;">
            <button class="btn" type="submit" style="width: 100%;">Create account</button>
        </div>
    </form>

    <p class="muted" style="margin-top: 20px;">
        Already have an account? <a href="/customer/login" style="color: var(--primary); text-decoration: none;">Login here</a>
    </p>
</section>
