<section class="card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; gap: 12px; flex-wrap: wrap;">
        <div>
            <div class="badge badge-info">Guest Dashboard</div>
            <h2 style="margin: 12px 0 0;">My reservations</h2>
        </div>
        <span class="muted">Welcome, <%= customer.name %></span>
    </div>

    <% if (!reservations || reservations.length === 0) { %>
        <div class="panel" style="text-align: center; padding: 40px;">
            <p class="muted" style="font-size: 18px; margin-bottom: 16px;">No reservations yet</p>
            <a href="/book" class="btn">Book a Room</a>
        </div>
    <% } else { %>
        <div style="display: grid; gap: 16px;">
            <% reservations.forEach(r => { %>
                <div class="panel">
                    <div style="display: flex; justify-content: space-between; align-items: start; flex-wrap: wrap; gap: 16px;">
                        <div style="flex: 1; min-width: 250px;">
                            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
                                <strong style="font-size: 18px;">Reservation #<%= r.id %></strong>
                                <span class="badge <%= r.status === 'checked_in' ? 'badge-success' : r.status === 'booked' ? 'badge-warning' : r.status === 'checked_out' ? 'badge-info' : 'badge-danger' %>" style="padding: 4px 10px; border-radius: 6px; font-size: 12px;">
                                    <%= r.status %>
                                </span>
                            </div>
                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; margin-bottom: 12px;">
                                <div>
                                    <span class="muted" style="font-size: 12px;">Room</span>
                                    <div><strong>Room <%= r.room_number %></strong> — <%= r.room_type %></div>
                                </div>
                                <div>
                                    <span class="muted" style="font-size: 12px;">Check-in</span>
                                    <div><strong><%= r.check_in %></strong></div>
                                </div>
                                <div>
                                    <span class="muted" style="font-size: 12px;">Check-out</span>
                                    <div><strong><%= r.check_out %></strong></div>
                                </div>
                                <div>
                                    <span class="muted" style="font-size: 12px;">Price/Night</span>
                                    <div><strong>₹<%= r.price_per_night %></strong></div>
                                </div>
                            </div>
                            <div style="margin-top: 8px;">
                                <span class="muted" style="font-size: 12px;">Payment Status: </span>
                                <span class="badge <%= r.payment_status === 'paid' || r.payment_status === 'confirmed' ? 'badge-success' : r.payment_status === 'submitted' ? 'badge-warning' : 'badge-danger' %>" style="padding: 2px 8px; font-size: 11px;">
                                    <%= r.payment_status %>
                                </span>
                            </div>
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 8px; align-items: flex-end;">
                            <% if (r.status === 'booked') { %>
                                <form method="post" action="/customer/reservation/<%= r.id %>/cancel" style="display: inline;">
                                    <button class="btn btn-ghost" type="submit" onclick="return confirm('Are you sure you want to cancel this reservation?')" style="padding: 8px 16px; font-size: 12px;">Cancel Booking</button>
                                </form>
                            <% } %>
                            <% if (r.status === 'checked_in') { %>
                                <div style="display: flex; flex-direction: column; gap: 8px; width: 100%;">
                                    <button class="btn" onclick="showServiceRequest(<%= r.id %>)" style="padding: 8px 16px; font-size: 12px; width: 100%;">Request Service</button>
                                    <a href="/reservation/<%= r.id %>" class="btn btn-ghost" style="padding: 8px 16px; font-size: 12px; text-align: center; text-decoration: none;">View Details</a>
                                </div>
                            <% } else if (r.status === 'booked' || r.status === 'checked_out') { %>
                                <a href="/reservation/<%= r.id %>" class="btn btn-ghost" style="padding: 8px 16px; font-size: 12px; text-align: center; text-decoration: none;">View Details</a>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>
</section>

<!-- Service Request Modal -->
<div id="serviceModal" class="modal-backdrop">
    <div class="card modal-card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h3 style="margin: 0;">Request Service</h3>
            <button onclick="closeServiceModal()" style="background: transparent; border: none; color: var(--text); font-size: 24px; cursor: pointer; padding: 0; width: 30px; height: 30px;">×</button>
        </div>
        <form method="post" action="/customer/service-request" class="form-grid" style="grid-template-columns: 1fr;">
            <input type="hidden" name="reservation_id" id="service_reservation_id">
            <label>
                <strong>Service Type</strong>
                <select name="service_type" required>
                    <option value="">Select a service</option>
                    <option value="room_service">Room Service</option>
                    <option value="housecleaning">House Cleaning</option>
                </select>
            </label>
            <label>
                <strong>Request Details (Optional)</strong>
                <textarea name="request_details" rows="4" placeholder="Please provide any specific details or requirements..."></textarea>
            </label>
            <div style="display: flex; gap: 10px; margin-top: 8px;">
                <button class="btn" type="submit" style="flex: 1;">Submit Request</button>
                <button class="btn btn-ghost" type="button" onclick="closeServiceModal()" style="flex: 1;">Cancel</button>
            </div>
        </form>
    </div>
</div>

<script>
function showServiceRequest(reservationId) {
    document.getElementById('service_reservation_id').value = reservationId;
    document.getElementById('serviceModal').classList.add('is-open');
}

function closeServiceModal() {
    document.getElementById('serviceModal').classList.remove('is-open');
    document.querySelector('#serviceModal form').reset();
}
</script>

