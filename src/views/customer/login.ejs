<section class="card" style="max-width: 480px; margin: 40px auto;">
    <div class="badge badge-info">Guest Access</div>
    <h2 style="margin-bottom: 8px;">Customer login</h2>
    <p class="muted" style="margin-bottom: 24px;">
        <% if (redirect === 'book') { %>
            Sign in with your registered mobile number to continue booking.
        <% } else { %>
            Sign in with your registered mobile number and password.
        <% } %>
    </p>

    <% if (registered) { %>
        <div class="panel" style="margin-bottom: 20px; color: var(--accent); border-color: rgba(20, 184, 166, 0.3);">
            ✓ Registration successful! Login with your mobile number and password.
        </div>
    <% } %>

    <% if (error) { %>
        <div class="panel error" style="margin-bottom: 20px; border-color: rgba(225, 29, 72, 0.3);">
            <%= error %>
        </div>
    <% } %>

    <form method="post" action="/customer/login" class="form-grid" style="grid-template-columns: 1fr;">
        <label>
            <strong>Registered mobile number</strong>
            <input name="phone" type="tel" required placeholder="10-digit mobile number" pattern="[0-9]{10}" maxlength="10" autocomplete="tel" autofocus>
        </label>

        <label>
            <strong>Password</strong>
            <input name="password" type="password" required placeholder="Enter your password" autocomplete="current-password">
        </label>

        <button class="btn" type="submit" style="width: 100%; margin-top: 8px;">Login</button>
    </form>

    <p class="muted" style="margin-top: 20px;">
        Don't have an account? <a href="/customer/register" style="color: var(--primary); text-decoration: none;">Register here</a>
    </p>
</section>
