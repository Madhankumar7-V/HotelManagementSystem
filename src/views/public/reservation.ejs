<section class="grid two">
    <article class="card">
        <div style="display:flex; justify-content:space-between; gap:12px; align-items:flex-start; flex-wrap:wrap;">
            <div>
                <div class="badge badge-info">Reservation #<%= reservation.id %></div>
                <h2 style="margin:12px 0 8px;">Booking status overview</h2>
            </div>
            <span class="badge <%= reservation.status === 'checked_in' ? 'badge-success' : reservation.status === 'booked' ? 'badge-warning' : reservation.status === 'checked_out' ? 'badge-info' : 'badge-danger' %>">
                <%= reservation.status %>
            </span>
        </div>

        <div class="row"><span>Booking reference</span><strong><%= reservation.booking_reference || 'Pending' %></strong></div>
        <div class="row"><span>Guest</span><strong><%= reservation.customer_name %></strong></div>
        <div class="row"><span>Contact</span><strong><%= reservation.customer_email || reservation.customer_phone || 'Not provided' %></strong></div>
        <div class="row"><span>Room</span><strong>Room <%= reservation.room_number %> · <%= reservation.room_type %></strong></div>
        <div class="row"><span>Stay dates</span><strong><%= reservation.check_in %> to <%= reservation.check_out %></strong></div>
        <div class="row"><span>Payment review</span><strong><%= reservation.payment_status || 'submitted' %></strong></div>
        <div class="row"><span>Transaction ID</span><strong><%= reservation.payment_txn_id || 'Pending upload' %></strong></div>

        <div class="panel" style="margin-top:18px;">
            <strong>Next step</strong>
            <p class="muted" style="margin-bottom:0;">This booking remains under manual verification until payment is cross-checked. After confirmation, you can send the final guest email outside the app.</p>
        </div>

        <div class="form-inline" style="margin-top:18px;">
            <% if (reservation.status === 'booked') { %>
                <form method="post" action="/reservation/<%= reservation.id %>/cancel">
                    <button class="btn btn-ghost" type="submit">Cancel reservation</button>
                </form>
            <% } %>
            <a class="btn" href="/">Back to home</a>
        </div>
    </article>

    <aside class="card">
        <h3>Payment proof</h3>
        <% if (reservation.payment_proof_path) { %>
            <img src="<%= reservation.payment_proof_path %>" alt="Payment proof" style="max-width:100%; border-radius:18px; border:1px solid var(--border);">
        <% } else { %>
            <p class="muted">No payment proof uploaded yet.</p>
        <% } %>
    </aside>
</section>


